# Rust build artifacts
/target/
**/*.rs.bk
*.pdb

# cc-memory plugin local state (not part of this project's source)
/memory/

# Render outputs / scratch (we don't version generated images)
/out/
/output/
*.tmp

# AI-denoise sidecar: downloaded model weights (~137 MB) + Python caches.
# The code (python/denoise.py) is versioned; the weights are fetched on first run.
/python/weights/
**/__pycache__/

# User-provided deploy credential (Cloudflare API token for the site, user
# directive 2026-08-23): lives at repo root by the user's choice, must never
# be committed or printed. Deploy tooling reads it into the process env.
.secret

# Local config that may hold secrets (OpenAI/analysis API keys, model choices).
# Written by the in-app Settings panel; never commit it. The glob also covers
# .env.evalbak — eval batches shelve .env aside for their duration so the
# process environment wins the dotenv precedence, and the shelved copy holds
# the same secret the bare name does.
.env
.env.*
autoshade.local.toml
autoshade.local.json

# Development ledgers (user ruling 2026-08-20): working process records, kept
# ON DISK at their long-standing paths (code comments cite them) but off the
# GitHub remote. ROADMAP.md stays tracked; these two are snapshotted to the
# private plans archive at every release ledger-stamp instead of git.
/docs/M1_PLAN.md
/docs/V2_PLAN.md

# OS / editor cruft
Thumbs.db
.DS_Store
desktop.ini
.vscode/
.idea/
.gstack/
.claude/

.ce/

# Stable local install dir (desktop shortcut target; survives cargo clean).
# The v1.0.0 installer formalizes the install location; dist/ stays local.
/dist/
.secret*
.wrangler/

# cc-memory project state (tool-local, never content)
.ccm/
