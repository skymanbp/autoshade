  "cards": [
    {
      "dot": "cyan",
      "title": "Doctrine",
      "items": [
        "The AI decides what to change; a deterministic Rust engine does it",
        "Reproducible — same recipe + same RAW ⇒ byte-identical output",
        "Non-destructive — the recipe is a small JSON, originals are never modified",
        "Auditable — every recipe carries a rationale + confidence",
        "Lightroom-interoperable — the sidecar merges into an existing crs: document"
      ]
    },
    {
      "dot": "amber",
      "title": "Opt-in exceptions that DO produce pixels",
      "items": [
        "SCUNet denoise (denoise.rs → python/denoise.py)",
        "gpt-image-2 reimagine / retouch via the Images API /v1/images/edits",
        "Deterministic pixel heal (retouch.rs)",
        "Each is explicit, requested by the user, and labelled as generated"
      ]
    },
    {
      "dot": "violet",
      "title": "Reverse-fit and style matching",
      "items": [
        "fit.rs, fit_zoned/ and fit_field.rs fit an EditRecipe to a target look",
        "A structural-divergence gate chooses Full or Atmosphere mode",
        "Semantic zones or luminance-range bands, then frozen-evidence quadtree tiles",
        "The local-field analyzer is read-only: it discloses a ceiling and a shape, never reaching the engine",
        "style.rs ranks z-scored RAW + XMP exemplars, optionally with SigLIP 2 embeddings"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust and privacy",
      "items": [
        "The verifier receives the recipe, EXIF and histogram — never pixels",
        "Responses API requests set store: false",
        "serve binds 127.0.0.1, mints a per-run session token and checks Host / Origin",
        "Sidecar weights are sha256- and byte-pinned, fetched on first use, never in the repository"
      ]
    }
  ]
